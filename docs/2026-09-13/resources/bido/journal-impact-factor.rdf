<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:nodeID="ndb2caccaf97d47009a1768dce3ae60abb20">
    <owl:allValuesFrom rdf:nodeID="ndb2caccaf97d47009a1768dce3ae60abb21"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:nodeID="ndb2caccaf97d47009a1768dce3ae60abb23"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb2caccaf97d47009a1768dce3ae60abb21">
    <owl:onProperty rdf:nodeID="ndb2caccaf97d47009a1768dce3ae60abb22"/>
    <owl:allValuesFrom rdf:resource="http://purl.org/spar/fabio/Journal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/spar/bido/journal-impact-factor">
    <rdf:type rdf:nodeID="ndb2caccaf97d47009a1768dce3ae60abb19"/>
    <rdf:type rdf:resource="http://purl.org/spar/bido/BibliometricMeasure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment>A measure reflecting the average number of citations to recent articles published in the journal. It is frequently used as a proxy for the relative importance of a journal within its field, with journals with higher impact factors deemed to be more important than those with lower ones.</rdfs:comment>
    <vann:example>
    :my-numeric-bibliometric-data a bido:NumericBibliometricData ;
        bido:hasMeasure bido:journal-impact-factor ;
        bido:hasNumericValue "2.464"^^xsd:float .
    </vann:example>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/bido-standard-bibliometric-measures/"/>
    <rdfs:label>journal impact factor</rdfs:label>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb2caccaf97d47009a1768dce3ae60abb19">
    <owl:allValuesFrom rdf:nodeID="ndb2caccaf97d47009a1768dce3ae60abb20"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:nodeID="ndb2caccaf97d47009a1768dce3ae60abb24"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb2caccaf97d47009a1768dce3ae60abb22">
    <owl:inverseOf rdf:resource="http://purl.org/spar/bido/holdsBibliometricDataInTime"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb2caccaf97d47009a1768dce3ae60abb24">
    <owl:inverseOf rdf:resource="http://purl.org/spar/bido/hasMeasure"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb2caccaf97d47009a1768dce3ae60abb23">
    <owl:inverseOf rdf:resource="http://purl.org/spar/bido/withBibliometricData"/>
  </rdf:Description>

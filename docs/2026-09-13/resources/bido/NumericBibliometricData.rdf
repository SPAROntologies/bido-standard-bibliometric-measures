  <rdf:Description rdf:about="http://purl.org/spar/bido/NumericBibliometricData">
    <rdfs:subClassOf rdf:nodeID="ndb2caccaf97d47009a1768dce3ae60abb30"/>
    <rdfs:subClassOf rdf:nodeID="ndb2caccaf97d47009a1768dce3ae60abb25"/>

    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "en",
        "@value": "\nThis module of BiDO describes a list of possible bibliometric measures that can be used to define bibliometric data of publication-related entities, e.g.: h-index, e-index, journal impact factor, author citation count.\n\n![The architecture of the BiDO-Standard-Bibliometric-Measures module.](bido-standard-bibliometric-measures.png)\n\n"
      }
    ],
    "http://purl.org/dc/elements/1.1/language": [

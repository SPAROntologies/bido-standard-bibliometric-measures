  <rdf:Description rdf:about="http://www.w3.org/2006/time#TemporalEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">temporal entity</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2006/time#"/>
    <rdfs:comment xml:lang="en">A temporal interval or instant.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/spar/bido/e-index">
    <rdf:type rdf:resource="http://purl.org/spar/bido/BibliometricMeasure"/>
    <rdf:type rdf:nodeID="na33f427d47174a8182f83607fdca09b9b7"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label>e-index</rdfs:label>
    <vann:example>
    :my-numeric-bibliometric-data a bido:NumericBibliometricData ;
        bido:hasMeasure bido:e-index ;
        bido:hasNumericValue "3"^^xsd:integer .
    </vann:example>
    <rdfs:comment>An h-index complement, aimed at considering the contributions of excess citations, which are mainly from highly cited papers. It is necessary, especially for evaluating highly cited scientists or for precisely comparing the scientific output of a group of scientists having an identical h-index.</rdfs:comment>
    <ns4:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/bido-standard-bibliometric-measures/"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://www.essepuntato.it/2012/04/tvc/withinContext">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/tvc/"/>
